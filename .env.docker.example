# Copy to a private .env and replace every placeholder. Never commit that file.

# Database (development examples; unsuitable as production credentials)
POSTGRES_DB=order_assistant
POSTGRES_USER=order_assistant
POSTGRES_PASSWORD=replace-with-a-random-development-password
ORDER_ASSISTANT_API_PORT=8000

# Application
ORDER_ASSISTANT_ENVIRONMENT=production
ORDER_ASSISTANT_IDENTITY_PROVIDER=demo_headers
ORDER_ASSISTANT_PERSISTENCE_BACKEND=sqlalchemy
ORDER_ASSISTANT_EXTRACTOR_BACKEND=disabled
ORDER_ASSISTANT_LLM_ROLLOUT_MODE=disabled

# ERP defaults to fake. The local compose.erp-stub.yaml override uses these.
ORDER_ASSISTANT_ERP_BACKEND=fake
ERP_STUB_TOKEN=replace-with-a-random-local-stub-token

# Audit secret: replace with at least 32 random characters.
ORDER_ASSISTANT_AUDIT_HMAC_KEY=replace-with-a-random-secret

# Ollama stays on the host and is only used by the explicit shadow override.
ORDER_ASSISTANT_OLLAMA_BASE_URL=http://host.docker.internal:11434
ORDER_ASSISTANT_OLLAMA_MODEL=qwen3.5:9b
ORDER_ASSISTANT_OLLAMA_PROMPT_VERSION=v2
ORDER_ASSISTANT_OLLAMA_THINK=false
ORDER_ASSISTANT_OLLAMA_TIMEOUT_SECONDS=180

# Runtime resilience
ORDER_ASSISTANT_LLM_MAX_CONCURRENCY=1
ORDER_ASSISTANT_LLM_QUEUE_CAPACITY=4
ORDER_ASSISTANT_LLM_QUEUE_WAIT_TIMEOUT_SECONDS=5
ORDER_ASSISTANT_LLM_CIRCUIT_FAILURE_THRESHOLD=3
ORDER_ASSISTANT_LLM_CIRCUIT_OPEN_SECONDS=30
ORDER_ASSISTANT_LLM_CIRCUIT_HALF_OPEN_MAX_CALLS=1
ORDER_ASSISTANT_LLM_TRANSPORT_MAX_ATTEMPTS=1
ORDER_ASSISTANT_READINESS_CACHE_SECONDS=5
