ORDER_ASSISTANT_ENVIRONMENT=development
ORDER_ASSISTANT_IDENTITY_PROVIDER=demo_headers
ORDER_ASSISTANT_PERSISTENCE_BACKEND=memory
# ORDER_ASSISTANT_DATABASE_URL=sqlite:///./order_assistant.db
ORDER_ASSISTANT_EXTRACTOR_BACKEND=disabled
ORDER_ASSISTANT_OLLAMA_BASE_URL=http://localhost:11434
ORDER_ASSISTANT_OLLAMA_MODEL=qwen3.5:9b
ORDER_ASSISTANT_OLLAMA_TIMEOUT_SECONDS=120
ORDER_ASSISTANT_OLLAMA_PROMPT_VERSION=v2
ORDER_ASSISTANT_OLLAMA_THINK=false
ORDER_ASSISTANT_LLM_ROLLOUT_MODE=disabled
ORDER_ASSISTANT_AUDIT_HMAC_KEY=replace-with-a-random-local-secret
ORDER_ASSISTANT_LLM_MAX_CONCURRENCY=1
ORDER_ASSISTANT_LLM_QUEUE_CAPACITY=4
ORDER_ASSISTANT_LLM_QUEUE_WAIT_TIMEOUT_SECONDS=5
ORDER_ASSISTANT_LLM_CIRCUIT_FAILURE_THRESHOLD=3
ORDER_ASSISTANT_LLM_CIRCUIT_OPEN_SECONDS=30
ORDER_ASSISTANT_LLM_CIRCUIT_HALF_OPEN_MAX_CALLS=1
ORDER_ASSISTANT_LLM_TRANSPORT_MAX_ATTEMPTS=1
ORDER_ASSISTANT_READINESS_CACHE_SECONDS=5
